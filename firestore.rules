rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity validation helpers
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'xp', 'streak', 'level', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'xp', 'streak', 'level', 'updatedAt', 'createdAt']) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 256 &&
        data.displayName is string && data.displayName.size() <= 150 &&
        data.xp is number && data.xp >= 0 &&
        data.streak is number && data.streak >= 0 &&
        data.level is string && data.level.size() <= 50 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidProgress(data) {
      return data.keys().hasAll(['userId', 'lessonId', 'completed', 'completedAt']) &&
        data.keys().hasOnly(['userId', 'lessonId', 'category', 'score', 'completed', 'completedAt']) &&
        data.userId is string && data.userId.size() <= 128 &&
        data.lessonId is string && data.lessonId.size() <= 128 &&
        data.completed is bool &&
        data.completedAt is string && data.completedAt.size() <= 64 &&
        (!('category' in data) || (data.category is string && data.category.size() <= 64)) &&
        (!('score' in data) || (data.score is number && data.score >= 0 && data.score <= 100));
    }

    function isValidSavedWord(data) {
      return data.keys().hasAll(['userId', 'wordId', 'arabic', 'meaning', 'savedAt']) &&
        data.keys().hasOnly(['userId', 'wordId', 'arabic', 'transliteration', 'meaning', 'category', 'savedAt']) &&
        data.userId is string && data.userId.size() <= 128 &&
        data.wordId is string && data.wordId.size() <= 128 &&
        data.arabic is string && data.arabic.size() <= 200 &&
        data.meaning is string && data.meaning.size() <= 500 &&
        data.savedAt is string && data.savedAt.size() <= 64 &&
        (!('transliteration' in data) || (data.transliteration is string && data.transliteration.size() <= 200)) &&
        (!('category' in data) || (data.category is string && data.category.size() <= 100));
    }

    function isValidQuizResult(data) {
      return data.keys().hasAll(['userId', 'quizId', 'quizTitle', 'score', 'totalQuestions', 'percentage', 'completedAt']) &&
        data.keys().hasOnly(['userId', 'quizId', 'quizTitle', 'category', 'score', 'totalQuestions', 'percentage', 'completedAt']) &&
        data.userId is string && data.userId.size() <= 128 &&
        data.quizId is string && data.quizId.size() <= 128 &&
        data.quizTitle is string && data.quizTitle.size() <= 200 &&
        data.score is number && data.score >= 0 &&
        data.totalQuestions is number && data.totalQuestions > 0 &&
        data.percentage is number && data.percentage >= 0 && data.percentage <= 100 &&
        data.completedAt is string && data.completedAt.size() <= 64 &&
        (!('category' in data) || (data.category is string && data.category.size() <= 64));
    }

    // User profile matching
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Deny blanket listing of user profiles
      allow create: if isOwner(userId) && isValidId(userId) &&
        isValidUser(incoming()) && incoming().uid == request.auth.uid;
      allow update: if isOwner(userId) && isValidId(userId) &&
        isValidUser(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt;
      allow delete: if false;

      // User lesson progress
      match /progress/{progressId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(progressId) &&
          isValidProgress(incoming()) && incoming().userId == request.auth.uid;
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(progressId) &&
          isValidProgress(incoming()) && incoming().userId == request.auth.uid;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(progressId);
      }

      // User saved vocabulary
      match /saved_words/{savedWordId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(savedWordId) &&
          isValidSavedWord(incoming()) && incoming().userId == request.auth.uid;
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(savedWordId) &&
          isValidSavedWord(incoming()) && incoming().userId == request.auth.uid;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(savedWordId);
      }

      // User quiz results
      match /quiz_results/{quizResultId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(quizResultId) &&
          isValidQuizResult(incoming()) && incoming().userId == request.auth.uid;
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(quizResultId) &&
          isValidQuizResult(incoming()) && incoming().userId == request.auth.uid;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(quizResultId);
      }
    }
  }
}
