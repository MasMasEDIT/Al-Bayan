rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Aturan keamanan bawaan: Tolak semua akses publik / tanpa login
    match /{document=**} {
      allow read, write: if false;
    }

    // Fungsi pembantu pengecekan otentikasi
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 2. Data khusus per pengguna (User Isolation)
    // Setiap user hanya memiliki izin baca & tulis pada dokumen dan subkoleksi miliknya sendiri
    match /users/{userId} {
      // User hanya dapat membaca dan memperbarui profil mereka sendiri
      allow read, write: if isOwner(userId);

      // Subkoleksi user (progress belajar, kamus tersimpan, dan hasil kuis)
      // Hanya dapat diakses (read, write, delete) oleh pemilik userId
      match /progress/{progressId} {
        allow read, write: if isOwner(userId);
      }

      match /saved_words/{savedWordId} {
        allow read, write: if isOwner(userId);
      }

      match /quiz_results/{quizResultId} {
        allow read, write: if isOwner(userId);
      }

      // Melindungi subkoleksi turunan lainnya di masa depan
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
